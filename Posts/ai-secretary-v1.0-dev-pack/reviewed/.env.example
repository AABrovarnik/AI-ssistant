# =========================================================
# AI Secretary v1.0
# Copy to .env and fill secrets.
# NEVER COMMIT .env
# =========================================================

# App
APP_ENV=development
APP_NAME=ai-secretary
LOG_LEVEL=INFO
# IANA timezone для системных задач (digest/scheduler), напр. Europe/Amsterdam.
# Часовой пояс конкретного пользователя хранится отдельно в users.timezone
# и должен запрашиваться при онбординге, а не наследоваться отсюда.
TIMEZONE=UTC

# API
API_BIND_HOST=127.0.0.1
API_PORT=8000
INTERNAL_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# PostgreSQL
POSTGRES_DB=ai_secretary
POSTGRES_USER=ai_secretary
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://ai_secretary:CHANGE_ME@db:5432/ai_secretary

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_MODE=polling
# For webhook mode later:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# OpenClaw / LLM
LLM_PROVIDER=openclaw
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible fallback
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gmail
GMAIL_ENABLED=false
GMAIL_POLL_MINUTES=15
GMAIL_QUERY=in:inbox newer_than:2d

# Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary

# Token encryption
# Generate a strong secret; implementation may use Fernet/base64-url key.
TOKEN_ENCRYPTION_KEY=

# Reminders
MORNING_DIGEST_TIME=08:00
EVENING_REVIEW_TIME=19:00
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
REMINDER_SCAN_MINUTES=5
OVERDUE_SCAN_MINUTES=60

# Policies
AUTO_CREATE_OWNER_TASKS=false
AUTO_CREATE_EXTERNAL_TASKS=false
AUTO_CALENDAR=false
REQUIRE_CONFIRM_EXTERNAL_ACTIONS=true

# Backups
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# Optional error tracking
SENTRY_DSN=
