# AI Secretary v1.0
# Copy to .env and replace all CHANGE_ME values.

APP_ENV=development
APP_NAME=ai-secretary
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

API_BIND_HOST=127.0.0.1
API_PORT=8000
INTERNAL_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

POSTGRES_DB=ai_secretary
POSTGRES_USER=ai_secretary
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://ai_secretary:CHANGE_ME@db:5432/ai_secretary

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_MODE=polling

LLM_PROVIDER=openclaw
# Docker bridge address of the host OpenClaw Gateway for this deployment.
# Replace 172.18.0.1 if the compose network uses another gateway address.
OPENCLAW_BASE_URL=http://172.18.0.1:18789
OPENCLAW_API_KEY=
LLM_MODEL=openclaw/default
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
GMAIL_QUERY=in:anywhere -label:spam
GOOGLE_CALENDAR_ENABLED=false

TOKEN_ENCRYPTION_KEY=
